# --- Field Intelligence configuration ---
# Copy to .env and fill in. NEVER commit .env.

# LLM
LLM_PROVIDER=gemini            # gemini | fixture
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Google Maps Platform. Two settings must BOTH be right, and they are separate:
#   1. "Places API (New)" enabled on the project, and
#   2. "Places API (New)" present in the key's API-restriction list.
# The legacy "Places API" is a DIFFERENT entry and does not grant access to the
# v1 endpoints — having only that one yields 403 API_KEY_SERVICE_BLOCKED.
GOOGLE_MAPS_API_KEY=

# --- Agent behaviour ---
# Adversarial challenge panel: 3 extra calls per candidate finding (~0.3c/audit).
# Off makes the demo faster and is how you measure what the panel actually changes.
ENABLE_CHALLENGE_PANEL=true
CHALLENGE_PANEL_DURING_CAPTURE=false

# Public-web review collection. Off by default (ADR-010). Needs a browser:
#   pip install playwright && playwright install chromium
ENABLE_SCRAPED_SIGNALS=false

# Identifies this app to OpenStreetMap/Nominatim, whose usage policy requires a
# real User-Agent and a contact. No key needed — OSM is keyless and free.
CONTACT_URL=

# App
APP_ENV=development
APP_DEMO_MODE=true             # true => fixture fallbacks are allowed and labelled
CORS_ORIGINS=                  # production only; comma-separated trusted origins
DATABASE_URL=sqlite:///./var/fieldintel.db   # postgresql+psycopg://... in production
APP_TENANT_ID=broadpeak-demo
APP_LOCATION_ID=wolf-creek-atlanta

# Cost guardrails
MAX_LLM_CALLS_PER_AUDIT=25
LLM_BUDGET_EXTENSION_CALLS=15
MAX_LLM_BUDGET_ACKNOWLEDGEMENTS=2

# --- OR: Vertex AI route instead of GEMINI_API_KEY ---
# GEMINI_VERTEX_SA_JSON accepts a path to the service-account JSON or the JSON inline (one line)
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1
GEMINI_VERTEX_SA_JSON=

# Optional: set to 0 to disable model thinking for faster/cheaper structured calls
LLM_THINKING_BUDGET=
